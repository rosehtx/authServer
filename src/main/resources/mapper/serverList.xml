<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.serverlist.authserver.mapper.ServerListMapper">
    <select id="findByConditions" parameterType="map" resultType="com.serverlist.authserver.entity.ServerList">
        SELECT *
        FROM server_list
        WHERE 1 = 1
        <if test="serverId != null and serverId != 0">
            AND server_id = #{serverId}
        </if>
        <if test="type != null and type != 0">
            AND type = #{type}
        </if>
    </select>
</mapper>
